# Dependencies
/node_modules/
/.pnp
.pnp.*

# Next.js build output
/.next/
/out/
/build/

# Environment variables
# Keep real credentials out of Git; example templates are safe to commit.
.env*
!.env.example
!.env.*.example

# Vercel
.vercel/

# Supabase local CLI artifacts (keep migrations tracked)
/supabase/.temp/
/supabase/.branches/

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Test and coverage output
/coverage/
/playwright-report/
/test-results/

# TypeScript build cache
*.tsbuildinfo

# Local certificates and private keys
*.pem

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE local files
.idea/
*.swp
*.swo
